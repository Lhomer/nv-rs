+        armed,
+        ..Default::default()
+    });
+    eprintln!(
+        "EXPLORE prone armed {armed}: downed {} stood {:?} hands {:.2} planted {} weapon planted {} front_low {:?} after {:?} gave up? {:?}",
+        r.downed,
+        r.first_stood,
+        r.hand_share,
+        r.planted_frames,
+        r.weapon_planted,
+        r.front_low,
+        r.after,
+        r.notes.iter().filter(|n| n.contains("[np choice]") || n.contains("[np pose]")).map(|n| n.chars().take(90).collect::<String>()).collect::<Vec<_>>()
+    );
+    }
+}
