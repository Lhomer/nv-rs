+/// Addendum test 3 (clip 22:19): the capsule's move through the rise is bounded. From the rise's
+/// start to half a second after it stands, the reference travels at most 15 units, at most 1.9
+/// units in a frame of New Physics' own, and never lies more than `LAG_MOST` behind the pelvis.
+#[test]
+fn np_rise_root_bounded() {
+    let mut failed = Vec::new();
+    for (name, _, after, root_step) in rise_ends() {
+        let Some(a) = after else {
+            failed.push(format!("{name}: never stood"));
+            continue;
+        };
+        if a.rise_path > 15.0 {
+            failed.push(format!("{name}: travelled {:.1} u", a.rise_path));
+        }
+        if *root_step > 1.9 {
+            failed.push(format!("{name}: {root_step:.2} u in a frame"));
+        }
+        if a.lag > 3.0
+        /* LAG_MOST */
+        {
+            failed.push(format!("{name}: {:.2} u behind the pelvis", a.lag));
+        }
+    }
+    assert!(failed.is_empty(), "{failed:#?}");
 }
 
